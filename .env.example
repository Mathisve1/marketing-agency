# Copy to .env and fill in. Never commit a populated .env.
# Per-client overrides go in clients/<id>/.env (also gitignored).

# === Required: model + tooling API keys ============================
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
APIFY_API_TOKEN=

# === Required: Kling Omni-Video ====================================
KLING_API_KEY=
KLING_API_SECRET=

# === Required for the Analyst (Meta Ads insights) ==================
# Defaults are read from the root .env; per-client overrides may live
# in clients/<id>/.env so one Streamlit instance can serve many ad accounts.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# === Optional: cosmetic ============================================
AGENCY_NAME=Our Agency

# === Optional: defaults / overrides ================================
DEFAULT_MODEL=claude-sonnet-4-6
LOG_LEVEL=INFO

# Override these only if Kling or Meta change their endpoints.
# KLING_API_BASE_URL=https://api-singapore.klingai.com
# KLING_OMNI_ENDPOINT=/v1/videos/omni-video
# KLING_POLL_PATH=/v1/videos/{task_id}
# KLING_MODEL=kling-v3-omni
# KLING_POLL_MAX_WAIT_SEC=1200
# META_GRAPH_VERSION=v19.0
# META_MAX_ADS_RETURNED=200
