__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.streamlit/secrets.toml

# === Runtime data: never commit ====================================
# These paths are written by the running agents. They contain customer
# assets, scraped competitor intelligence, model API audit trails, and
# per-client commercial context. See SECURITY.md before adding rules.

# Per-client SQLite database + WAL/SHM journal files
clients/*/client_data.db
clients/*/client_data.db-shm
clients/*/client_data.db-wal

# Per-client runtime state
clients/*/.env
clients/*/performance_log.json

# Per-client customer-supplied assets and generated media
clients/*/references/
clients/*/outputs/

# Re-include the seed template (cloned by ClientContext.onboard for new
# clients). Nothing sensitive should ever be placed inside _template/.
!clients/_template/
!clients/_template/**

# Prospect data: scraped Meta ad libraries, audit JSON, pitch PDFs
prospects/

# API audit logs (Kling request/response bodies, includes prompts)
logs/

# LangGraph SqliteSaver checkpoint DB (HITL/in-flight graph state).
# Persistent so pending approvals survive process restart; regenerated
# on demand so safe to delete. WAL/SHM sidecars excluded too.
checkpoints.db
checkpoints.db-shm
checkpoints.db-wal

# V1.7: MCP pending-runs registry (operator-facing context for paused
# Producer approvals). Contains thread_id, prompt, client_id, model,
# task_type, plan_id and the LangGraph runtime config. Regenerated on
# demand by mcp_server.py / services/mcp_pending_store.py.
mcp_pending_runs.db
mcp_pending_runs.db-shm
mcp_pending_runs.db-wal

# Manual output-quality grades produced by scripts/eval_review.py.
# May contain real client/prospect names, artifact paths, and operator
# notes; never commit. The evals/ directory itself is preserved via
# evals/.gitkeep so a fresh clone has the target folder ready.
evals/output_reviews.jsonl
evals/*.csv

# V1.9 Pass 1 placeholders for Pass 2 runtime artifacts. The services
# don't exist yet but their on-disk paths are reserved here so the
# moment they ship the storage is gitignored without a follow-up commit.

# Operator persistent task store (Pass 2: services/operator_task_store.py).
operator_tasks.db
operator_tasks.db-shm
operator_tasks.db-wal

# Cost / activity ledger (Pass 2: services/cost_ledger.py).
cost_ledger.db
cost_ledger.db-shm
cost_ledger.db-wal

# Daily summary outputs (Pass 2: scripts/daily_summary.py --out ...).
# May reference real client/prospect names; never commit. The reports/
# directory is created on demand.
reports/daily-summary-*.md
reports/daily-summary-*.txt

# Wrangler (Cloudflare Pages CLI) writes a local cache here on first
# deploy. Per-machine, regenerated automatically; never commit.
.wrangler/
