# Yuvo Studio — Phase 1C environment variables.
#
# COPY this file to `web/.env.local` and fill in the values for your
# Supabase project. `.env.local` is gitignored by Next.js by default.
#
# To run the app off the local demo seed (no Supabase needed):
#   leave NEXT_PUBLIC_DATA_SOURCE=demo  (or unset it entirely)
#
# To run the app off your Supabase project:
#   1. Apply the migrations + seed (see docs/dashboard_phase_1b_supabase.md
#      and docs/dashboard_phase_1c_supabase_data_access.md).
#   2. Set NEXT_PUBLIC_DATA_SOURCE=supabase.
#   3. Fill in NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY.
#   4. OPTIONAL (until Supabase Auth lands): set
#      SUPABASE_SERVICE_ROLE_KEY to bypass RLS server-side. Without this,
#      RLS denies every read because auth.uid() is null in Phase 1C.

# ----------------------------------------------------------------------------
# Data source switch
# ----------------------------------------------------------------------------
# One of: demo | supabase
# Default: demo (renders Pai content from web/lib/demo-data.ts).
NEXT_PUBLIC_DATA_SOURCE=demo

# ----------------------------------------------------------------------------
# Supabase project credentials  (only required when DATA_SOURCE=supabase)
# ----------------------------------------------------------------------------
# Find these in: Supabase dashboard → Project settings → API.
# - URL:      Project URL (e.g. https://abcd1234.supabase.co)
# - Anon key: anon / public API key. Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# Service-role key  (server-only, OPTIONAL until Phase 1D wires real auth)
# ----------------------------------------------------------------------------
# WARNING: this key BYPASSES Row-Level-Security. NEVER prefix it with
# NEXT_PUBLIC_, never ship it to the browser, and never commit it.
#
# Why it's optional:
#   Phase 1C does not implement Supabase Auth. Without auth, auth.uid()
#   is null inside RLS helpers, and every policy denies access. Setting
#   this key lets the operator verify the Supabase wiring end-to-end on
#   their own machine until the auth phase lands.
#
# Phase 1D status: auth is wired, but the client-feedback WRITE paths
# (approve / request-changes / comment) still need this key to flip
# content_items.status because the Phase 1B RLS policies don't grant
# UPDATE on content_items to the client persona. Phase 1E adds the
# per-policy UPDATE so this key becomes optional for normal operation.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Site URL  (Phase 1D — required for magic-link emails in supabase mode)
# ----------------------------------------------------------------------------
# The public origin of this Next.js app. Magic-link emails contain a
# link back to {NEXT_PUBLIC_SITE_URL}/auth/callback — so this MUST be
# reachable from the user's browser. For local dev that's just the dev
# server origin. For production set it to the deployed origin.
#
# Defaults to http://localhost:3000 if unset (only safe for local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
